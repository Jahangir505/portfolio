# Canonical public URL (no trailing slash). Used for canonical tags, sitemap,
# robots.txt, Open Graph and JSON-LD. Defaults to https://devjahangir.com in
# production builds and http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://devjahangir.com

# Optional: Google Search Console HTML-tag verification code (not needed for DNS verification).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form (server-only; never prefix these with NEXT_PUBLIC_)
RESEND_API_KEY=
CONTACT_EMAIL=
